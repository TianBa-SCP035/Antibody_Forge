# ========== 使用方式 ==========
# 1. 复制为同目录 vita_server.env（保留本模板）：
#      cp config/prod/vita_server.env.gitkeep config/prod/vita_server.env
# 2. 只改 vita_server.env，勿提交。首个超管见 docs/deploy.md「数据库」节。

# ========== prod 模板 ==========

# --- 服务 ---
# prod 环境即使为 false，代码也会开启定时任务（见 config.py）
ENABLE_SCHEDULER=false
APP_NAME=Antibody Forge API
HOST=127.0.0.1
PORT=8848
DEBUG=false

# --- 数据库（必填）---
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/bbctg_vita
# 生产必须换成高强度随机串
SECRET_KEY=please-change-me

REPOSITORY_ROOT=repository
# 与 Nginx listen 1314 对应
CORS_ORIGINS=http://127.0.0.1:1314

# --- 云之家（可选）---
YUNZHIJIA_APPID=
YUNZHIJIA_APPSECRET=

# --- DRM（可选）---
DRM_ENABLED=true
DRM_LIB_DIR=
DRM_SERVER_SSL=false
DRM_SERVER_HOST=
DRM_SERVER_PORT=0
DRM_USER_ID=
DRM_PASSWORD=
DRM_CONFIG_PATH=repository/cache/drm
DRM_ENCRYPT_OWNER_ID=
DRM_ENCRYPT_SECRET_LEVEL_ID=1

# Labillion 镁伽自动化（URL留空=不推送）
LABILLION_BASE_URL=
LABILLION_USERNAME=
LABILLION_PASSWORD=

# 本系统对外 API 根
PUBLIC_API_BASE_URL=

# --- 外部只读库（可选）---
CELL_DB_URL=
EMPLOYEE_DB_URL=
