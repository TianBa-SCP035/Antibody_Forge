# 可选：不配置时自动识别；Windows=local，Linux 下项目上级目录为 prod 时=prod，否则=test
# APP_ENV=local
ENABLE_SCHEDULER=false
APP_NAME=Antibody Forge API
HOST=0.0.0.0
# 推荐端口：local=8888，test=9527，prod=8848；test/prod 经 Nginx 反代时可将 HOST 改为 127.0.0.1
PORT=8888
DEBUG=true

DATABASE_URL=mysql+pymysql://user:password@localhost:3306/bbctg_vita
# 生产环境必须在 vita_server.env 中设置真实 DATABASE_URL，禁止依赖代码内占位默认。
SECRET_KEY=please-change-me
# 生产环境必须设置高强度随机 SECRET_KEY，禁止沿用示例或代码默认值。

REPOSITORY_ROOT=repository
CORS_ORIGINS=http://localhost:5555,http://127.0.0.1:5555

YUNZHIJIA_APPID=
YUNZHIJIA_APPSECRET=
YUNZHIJIA_AUTO_PROVISION=false
EQUIP_APPID=
EQUIP_APPSECRET=

# 外部细胞库存数据库，按需配置
CELL_DB_URL=

# 外部员工信息只读库，仅 prod 按需配置；不要提交真实连接串
EMPLOYEE_DB_URL=

# 开发环境临时登录用户，用于绕过云之家时模拟真实用户
DEV_USER_OPENID=
DEV_USER_NAME=周科钢 Kegang Zhou
