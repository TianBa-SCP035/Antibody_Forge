# ========== 使用方式 ==========
# 1. 复制为同目录 vita_server.env（保留本模板）：
#      cp config/test/vita_server.env.gitkeep config/test/vita_server.env
# 2. 只改 vita_server.env，勿提交。首个超管见 docs/deploy.md「数据库」节。

# ========== test 模板 ==========

# --- 服务 ---
# ENABLE_SCHEDULER: false|true（test 一般 false）
ENABLE_SCHEDULER=false
APP_NAME=Antibody Forge API
# Nginx 反代本机后端时用 127.0.0.1
HOST=127.0.0.1
PORT=9527
DEBUG=false

# --- 数据库（必填）---
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/bbctg_vita
SECRET_KEY=please-change-me

REPOSITORY_ROOT=repository
# 浏览器实际访问地址，逗号分隔；与 Nginx listen 9958 对应
CORS_ORIGINS=http://127.0.0.1:9958

# --- 云之家（可选）---
YUNZHIJIA_APPID=
YUNZHIJIA_APPSECRET=
YUNZHIJIA_AUTO_PROVISION=false

# --- DRM（可选）---
DRM_ENABLED=true
DRM_LIB_DIR=
DRM_SERVER_SSL=false
DRM_SERVER_HOST=
DRM_SERVER_PORT=0
DRM_USER_ID=
DRM_PASSWORD=
DRM_CONFIG_PATH=repository/cache/drm
DRM_ENCRYPT_OWNER_ID=
DRM_ENCRYPT_SECRET_LEVEL_ID=1

# --- 外部只读库（可选）---
CELL_DB_URL=
EMPLOYEE_DB_URL=
