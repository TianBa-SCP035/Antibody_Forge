# ========== 使用方式 ==========
# 1. 复制为同目录 vita_server.env（保留本模板）：
#      cp config/local/vita_server.env.gitkeep config/local/vita_server.env
# 2. 只改 vita_server.env，勿提交。首个超管见 docs/deploy.md「数据库」节。
# 后端只加载 vita_server.env；本 .gitkeep 可长期保留。

# ========== local 模板 ==========

# --- 服务 ---
# ENABLE_SCHEDULER: false|true（local 一般 false；prod 环境代码会强制开启）
ENABLE_SCHEDULER=false
APP_NAME=Antibody Forge API
# HOST: 0.0.0.0 便于本机/局域网访问；反代到本机时用 127.0.0.1
HOST=0.0.0.0
PORT=8888
DEBUG=true

# --- 数据库（必填）---
# 格式：mysql+pymysql://用户名:密码@主机:端口/库名
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/bbctg_vita
# JWT 等签名；local 也请改掉默认值
SECRET_KEY=please-change-me

# 附件、日志根目录（相对仓库根或绝对路径）
REPOSITORY_ROOT=repository
# 前端来源，逗号分隔；本地 Vite 默认 5555
CORS_ORIGINS=http://localhost:5555,http://127.0.0.1:5555

# --- 云之家（可选；不配则仅账号密码登录）---
# openid 须在 sys_user 中预先绑定；AUTO_PROVISION=true 时未绑定用户会自动建号
YUNZHIJIA_APPID=
YUNZHIJIA_APPSECRET=
YUNZHIJIA_AUTO_PROVISION=false

# --- DRM（可选；后台另开 feature.drm_file_security；无 SDK 时自动跳过）---
DRM_ENABLED=true
DRM_LIB_DIR=
DRM_SERVER_SSL=false
DRM_SERVER_HOST=
DRM_SERVER_PORT=0
DRM_USER_ID=
DRM_PASSWORD=
DRM_CONFIG_PATH=repository/cache/drm
DRM_ENCRYPT_OWNER_ID=
DRM_ENCRYPT_SECRET_LEVEL_ID=1

# Labillion 镁伽自动化（URL留空=不推送）
LABILLION_BASE_URL=
LABILLION_USERNAME=
LABILLION_PASSWORD=

# 本系统对外 API 根
PUBLIC_API_BASE_URL=http://127.0.0.1:8888/api

# --- 外部只读库（可选；留空则细胞库存/员工同步不可用）---
# 格式同 DATABASE_URL，指向外部 MySQL
CELL_DB_URL=
EMPLOYEE_DB_URL=
