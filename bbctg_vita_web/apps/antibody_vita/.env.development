# 端口号
VITE_PORT=5555

# 应用标题与偏好设置命名空间（勿留空，否则回退为 Vben 默认文案）
VITE_APP_TITLE=Antibody Vita
VITE_APP_NAMESPACE=antibody-forge-v1

VITE_BASE=/

# 与生产一致使用 history；Vite dev 已处理 SPA 回退
VITE_ROUTER_HISTORY=history

# 接口地址
VITE_GLOB_API_URL=/api

# 血清业务接口地址，开发环境由 Vite 代理并重写到新后端 /api
VITE_SERUM_API_URL=/serum-api

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
