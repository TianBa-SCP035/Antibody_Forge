# ========== 使用方式 ==========
# 1. 复制为同目录 vita_server.env（保留本模板）：
#      cp config/test/vita_server.env.gitkeep config/test/vita_server.env
# 2. 只改 vita_server.env，勿提交。首个超管见 docs/deploy.md「数据库」节。

# ========== test 模板 ==========

# --- 服务 ---
# 须与所在目录一致
APP_ENV=test
# 定时任务开关；prod 始终开启
ENABLE_SCHEDULER=false
APP_NAME=Antibody Forge API
# 只供本机 Nginx 反代
HOST=127.0.0.1
PORT=9527
DEBUG=false

# --- 数据库（必填）---
# mysql+pymysql://用户名:密码@主机:端口/库名
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/bbctg_vita
# 签名密钥，须改掉默认值；prod 至少 32 位
SECRET_KEY=please-change-me

# --- 目录与跨域 ---
# 附件、日志根目录（相对仓库根或绝对路径）
REPOSITORY_ROOT=repository
# 跨域白名单，逗号分隔；前端与 /api 同域（Nginx 或 Vite 代理）时留空
CORS_ORIGINS=

# --- 云之家（可选，不配只能账号密码登录）---
YUNZHIJIA_APPID=
YUNZHIJIA_APPSECRET=

# --- DRM 文件安全（可选，还需在后台开启该功能）---
# 动态库放 integrations/drm/lib（libdrmedi.so、libhttpcomm.so），缺失时跳过
DRM_ENABLED=true
DRM_LIB_DIR=
DRM_SERVER_SSL=false
DRM_SERVER_HOST=
DRM_SERVER_PORT=0
DRM_USER_ID=
DRM_PASSWORD=
DRM_CONFIG_PATH=repository/cache/drm
DRM_ENCRYPT_OWNER_ID=
DRM_ENCRYPT_SECRET_LEVEL_ID=1

# --- 外部只读库（可选，格式同 DATABASE_URL）---
CELL_DB_URL=
# 定时任务关闭时可留空
EMPLOYEE_DB_URL=
ONE_DB_URL=

# --- 镁伽自动化 ---
# 派单（URL 留空不推送）
LABILLION_BASE_URL=
LABILLION_USERNAME=
LABILLION_PASSWORD=
LABILLION_PLATFORM_ID=
# 本系统对外 API 根，派单回调地址由它拼出
PUBLIC_API_BASE_URL=
# 状态回调来源校验：令牌走请求头 X-Callback-Token，IP 逗号分隔，留空不校验
LABILLION_CALLBACK_TOKEN=
LABILLION_CALLBACK_IPS=
# 结果回传来源校验，同上
ORDER_SYNC_TOKEN=
ORDER_SYNC_IPS=
# 流式结果共享（SMB，下载可视化图和热图；HOST 留空不下载）
FCS_SMB_HOST=
FCS_SMB_PORT=445
FCS_SMB_SHARE=
FCS_SMB_USER=
FCS_SMB_PASSWORD=

# --- 上清板布局接收（合成公司调用）---
# 来源校验，同镁伽
SUPERNATANT_RECEIVE_TOKEN=
SUPERNATANT_RECEIVE_IPS=
# 合成公司上清板布局查询（本系统主动查），「合成公司=地址」英文分号分隔，令牌同上
SUPERNATANT_QUERY_URLS=
