VITE_APP_TITLE=Antibody Vita
VITE_APP_NAMESPACE=antibody-forge-v1

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 血清业务接口地址，生产环境由网关或 Nginx 重写到后端 /api
VITE_SERUM_API_URL=/serum-api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router：hash 带 #/；history 需 Nginx try_files 回退 index.html
VITE_ROUTER_HISTORY=history

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
